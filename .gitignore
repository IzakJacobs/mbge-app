# ============================================================
# gemB / MBGE — .gitignore (merged 2026-07-03)
# ============================================================
# Sensitive configuration
config.php
secret_pin.php
.user.ini
.env
.env.*

# ESP32 firmware (WiFi credentials + gate token)
esp32/gate_trigger/gate_trigger.ino
esp32/gate_entry/gate_entry.ino

# Separate repository (gemb-comms)
/comms/

# POPIA-sensitive content
private/
app_uploads/
uploads/

# Backups / archives (may contain config.php inside)
*.zip
*.tar.gz
*.sql.gz

# Logs, sessions, generated files
logs/
*.log
error_log
sessions/
temp/

# cPanel / hosting artifacts
.well-known/
.htpasswds/
.cpanel*
.ftpquota

# Editor / OS noise
*.bak
*~
.DS_Store
